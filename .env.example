# Salin file ini menjadi .env untuk konfigurasi lokal.
# Untuk lokal, biarkan DATABASE_URL memakai SQLite.
DATABASE_URL=sqlite:///./course_usage.db
# development membuat tabel SQLite otomatis dan tidak meminta API_KEY.
ENVIRONMENT=development
# Kosongkan untuk lokal. Isi secret acak hanya pada konfigurasi Render saat deploy.
API_KEY=
# Tarif Rupiah; opsional untuk diubah.
STUDY_RATE_PER_HOUR=2000
MATERIAL_RATE_PER_ACCESS=500
QUIZ_RATE_PER_COMPLETION=1000
