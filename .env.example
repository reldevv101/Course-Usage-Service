# Salin file ini menjadi .env untuk konfigurasi lokal.
# Untuk lokal, biarkan DATABASE_URL memakai SQLite.
DATABASE_URL=sqlite:///./course_usage.db
# development membuat tabel SQLite otomatis.
ENVIRONMENT=development
# Mode koneksi database: session untuk lokal/session pooler; transaction untuk Vercel.
DB_POOL_MODE=session
# Rahasia penandatangan token; buat nilai acak lokal dan isi terpisah di Vercel.
JWT_SECRET_KEY=
# Alamat frontend yang diizinkan memanggil API; tambahkan domain frontend Vercel saat deploy.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Tarif Rupiah; opsional untuk diubah.
STUDY_RATE_PER_HOUR=2000
MATERIAL_RATE_PER_ACCESS=500
QUIZ_RATE_PER_COMPLETION=1000
